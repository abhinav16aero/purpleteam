# deploy/env/shared.env — the coordinator's container env (env_file in docker-compose.redblue.yml).
# REDBLUE_ prefix (00 §7). Service-name aliases resolve on redblue-shared. Plan: 06/07.

# ── Engine drive-points (reached by service-name alias on redblue-shared) ──
REDBLUE_LANGGRAPH_URL=http://langgraph:2024
REDBLUE_DECEPTICON_NEO4J_URI=bolt://neo4j:7687
REDBLUE_DECEPTICON_NEO4J_USER=neo4j
# NOTE: no inline comments on value lines — compose env_file keeps everything after `=` literally
# (a `# ...` here would become part of the password). READ-ONLY role in prod (doc 06 §2.2).
REDBLUE_DECEPTICON_NEO4J_PASSWORD=decepticon-graph
REDBLUE_VIGIL_URL=http://backend:6987
# soc-daemon internal port is 8081 (host maps 8082).
REDBLUE_VIGIL_WEBHOOK_URL=http://soc-daemon:8081
REDBLUE_OLLAMA_URL=http://ollama:11434

# ── Coordinator store (SQLite MVP → Postgres later, 00 §6) ────────────────
REDBLUE_DB_URL=sqlite:////data/redblue.db

# ── Evidence signed-bundle export (doc 08 §5 / §25) ───────────────────────
# When SET, GET /api/engagements/:id/evidence/bundle is HMAC-SHA256 signed with this key. Leave
# EMPTY to ship digest-sealed (SHA-256) but UNSIGNED bundles. Use a strong per-deploy secret
# (e.g. `openssl rand -hex 32`); treat it like any signing key and never commit a real value.
# NOTE: no inline comment on the value line (env_file keeps everything after `=` literally).
REDBLUE_EVIDENCE_SIGNING_KEY=

# ── OLLAMA_MODEL tiers — owned by doc 03 (P1); placeholders here ──────────
# REDBLUE_OLLAMA_MODEL_HIGH=qwen2.5-coder:32b
# REDBLUE_OLLAMA_MODEL_LOW=llama3.2:3b
