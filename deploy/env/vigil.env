# deploy/env/vigil.env — Compose INTERPOLATION vars for the Vigil project (--env-file).
# Plan: plans/00_MASTER_PLAN.md §4/§5, plans/02 §1.6, plans/03 (Ollama)

# ── Point Vigil's LLM path at the shared Ollama container ─────────────────
# Every Vigil LLM service uses ${OLLAMA_URL:-http://host.docker.internal:11434}; on Linux
# host.docker.internal doesn't resolve, so we use the containerized ollama on redblue-shared.
OLLAMA_URL=http://ollama:11434
# BIFROST_URL keeps its default (http://bifrost:8080).
# SOVEREIGNTY (P1): DEFAULT_MODEL (override the cloud claude-sonnet-4-6 default) + the ollama-only
# Bifrost seed are set in deploy/overrides/vigil.redblue.yml.

# ── Postgres password (placeholder — override real secrets via a gitignored deploy/.env) ──
POSTGRES_PASSWORD=deeptempo_secure_password_change_me

# ── Daemon webhook internal port stays 8081 (host remapped to 8082 in the override) ──
DAEMON_WEBHOOK_PORT=8081

# NB: DEV_MODE (auth bypass) is app-level config read from Vigil's own env — it is NOT set
# by this compose. Set DEV_MODE=false before any exposure (plan 00 §10 / doc 08).
