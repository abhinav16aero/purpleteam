# deploy/env/decepticon.env — Compose INTERPOLATION vars for the Decepticon project.
# Passed via `--env-file` (Makefile). These fill the ${VAR:-default} host-port slots so the
# stack never collides with Vigil. NOT secrets (those live in Decepticon/.env, gitignored).
# Plan: plans/00_MASTER_PLAN.md section 4, plans/02 section 2.2
#
# IMPORTANT: `docker compose --env-file` does NOT strip inline `# comments` — everything after
# `=` is the literal value. Keep every comment on its OWN line. (A leaked inline comment here
# once set DECEPTICON_STACK_NAME to the comment text, poisoning every container_name via
# `decepticon${DECEPTICON_STACK_NAME:+-${DECEPTICON_STACK_NAME}}-*`.)

# -- Host-port remaps (00 section 4) --
# POSTGRES_PORT: was 5432 — Vigil keeps 5432 (the only forced collision).
POSTGRES_PORT=5433
# WEB_PORT: was 3000 — behind the default-off `web` profile.
WEB_PORT=3100
# TERMINAL_PORT: was 3003.
TERMINAL_PORT=3103
# LITELLM_PORT / NEO4J_HTTP_PORT / NEO4J_BOLT_PORT / LANGGRAPH_PORT / SKILLOGY_REST_PORT
# keep their defaults (4000 / 7474 / 7687 / 2024 / 9100) — no collision with Vigil.

# -- Stack identity --
# MUST stay empty (and MUST have no inline comment): empty → container names stay `decepticon-*`.
DECEPTICON_STACK_NAME=

# -- Sovereignty (P1 / plan 03) --
# The Decepticon CONTAINER env (OLLAMA_MODEL, DECEPTICON_AUTH_PRIORITY, telemetry-off, local
# embeddings) lives in Decepticon/.env (loaded via `env_file: .env`). This file is compose
# INTERPOLATION only. OLLAMA_API_BASE is also set on litellm via the override; kept here for ref.
OLLAMA_API_BASE=http://ollama:11434
