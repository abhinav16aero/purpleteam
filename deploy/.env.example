# deploy/.env.example — template for deploy-time SECRETS (copy to deploy/.env, gitignored).
# The non-secret interpolation vars live in deploy/env/{decepticon,vigil,shared}.env (tracked).
# Real secrets belong here (or in each engine's own encrypted store) and NEVER in git.

# Vigil
POSTGRES_PASSWORD=change_me_in_prod
# ANTHROPIC_API_KEY=            # leave EMPTY for sovereignty (Ollama-only) — doc 03
# OPENAI_API_KEY=

# Decepticon (its own Decepticon/.env holds LLM auth; created by `decepticon onboard` or doc 03)
NEO4J_PASSWORD=decepticon-graph
LITELLM_MASTER_KEY=sk-decepticon-master

# Grafana / pgAdmin (observability/dev profiles)
GRAFANA_PASSWORD=change_me
PGADMIN_PASSWORD=change_me
