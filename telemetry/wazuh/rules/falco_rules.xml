<!--
  telemetry/wazuh/rules/falco_rules.xml  (plan 04) — classify Falco runtime events so they reach Vigil.

  Falco writes JSON to the shared falco_logs volume; the manager tails it (ossec.conf <localfile> json)
  and matches these rules. The base rule is level 5 because the custom-vigil integration forwards every
  alert with rule.level >= 5; high-signal Falco rules are ELEVATED and MITRE-mapped, so the Vigil finding
  carries a technique (custom-vigil reads rule.mitre.id). Lane: Falco -> Wazuh -> custom-vigil -> Vigil.

  IDs use the local 100xxx range (Wazuh reserves >= 100000 for user rules). Auto-loaded via the existing
  <ruleset><rule_dir>etc/rules</rule_dir> in ossec.conf — this file mounts at etc/rules/falco_rules.xml.
-->
<group name="falco,redblue,">

  <!-- Any Falco event: JSON-decoded, carrying Falco's rule / priority / output (distinguishes it from
       Suricata's eve.json, which has no top-level 'rule'/'priority'). Level 5 => forwarded to Vigil. -->
  <rule id="100100" level="5">
    <decoded_as>json</decoded_as>
    <field name="rule" type="pcre2">.+</field>
    <field name="priority" type="pcre2">.+</field>
    <field name="output" type="pcre2">.+</field>
    <description>Falco runtime alert: $(rule)</description>
    <options>no_full_log</options>
  </rule>

  <!-- Interactive shell spawned inside a container — execution foothold after a web exploit. -->
  <rule id="100101" level="10">
    <if_sid>100100</if_sid>
    <field name="rule" type="pcre2">(?i)shell in( a)? container|terminal shell</field>
    <mitre><id>T1059</id></mitre>
    <description>Falco: shell spawned in a container — $(rule)</description>
  </rule>

  <!-- Container escape / breakout to the host. -->
  <rule id="100102" level="12">
    <if_sid>100100</if_sid>
    <field name="rule" type="pcre2">(?i)container escape|escape to host|change thread namespace</field>
    <mitre><id>T1611</id></mitre>
    <description>Falco: container escape / host breakout — $(rule)</description>
  </rule>

  <!-- Cloud instance-metadata (IMDS) access — credential theft from 169.254.169.254. -->
  <rule id="100103" level="10">
    <if_sid>100100</if_sid>
    <field name="rule" type="pcre2">(?i)instance metadata|\bimds\b|169\.254\.169\.254</field>
    <mitre><id>T1552.005</id></mitre>
    <description>Falco: cloud instance-metadata access — $(rule)</description>
  </rule>

  <!-- Privileged / sensitive-mount container launch. -->
  <rule id="100104" level="10">
    <if_sid>100100</if_sid>
    <field name="rule" type="pcre2">(?i)privileged container|sensitive mount</field>
    <mitre><id>T1610</id></mitre>
    <description>Falco: privileged / sensitive-mount container — $(rule)</description>
  </rule>

  <!-- Write below a sensitive path (/etc, /bin, root) — tampering / persistence. -->
  <rule id="100105" level="8">
    <if_sid>100100</if_sid>
    <field name="rule" type="pcre2">(?i)write below (etc|root|binary dir)|modify.*(bin|shell config)</field>
    <mitre><id>T1543</id></mitre>
    <description>Falco: write to a sensitive path — $(rule)</description>
  </rule>

</group>
